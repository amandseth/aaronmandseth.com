---
import { Icon } from "astro-icon/components";
---

<header
	id="site-header"
	class="fixed left-0 right-0 top-0 z-50 border-b border-white/10 bg-brand-background/75 backdrop-blur-md"
>
	<div
		class="container mx-auto flex max-w-[95vw] items-center justify-between py-4 md:max-w-[90vw] lg:max-w-(--breakpoint-2xl)"
	>
		<a
			href="#"
			class="text-md gap-4 font-semibold tracking-tight text-brand-foreground transition-colors hover:text-brand-highlight md:text-2xl"
		>
			Aaron Mandseth
		</a>
		<nav>
			<ul class="hidden list-none items-center gap-1 md:flex">
				<li>
					<a
						href="#about"
						class="rounded-md px-1 py-0.5 text-base text-brand-foreground-darker transition-colors hover:bg-white/5 hover:text-brand-foreground md:px-3 md:py-1.5"
						>About</a
					>
				</li>
				<li>
					<a
						href="#work"
						class="rounded-md px-1 py-0.5 text-base text-brand-foreground-darker transition-colors hover:bg-white/5 hover:text-brand-foreground md:px-3 md:py-1.5"
						>Work</a
					>
				</li>
				<li>
					<a
						href="#contact"
						class="rounded-md px-1 py-0.5 text-base text-brand-foreground-darker transition-colors hover:bg-white/5 hover:text-brand-foreground md:px-3 md:py-1.5"
						>Contact</a
					>
				</li>
			</ul>
		</nav>
		<button
			id="nav-toggle"
			type="button"
			aria-controls="mobile-nav"
			aria-expanded="false"
			aria-label="Open menu"
			class="rounded-md p-1.5 text-brand-foreground-darker transition-colors hover:bg-white/5 hover:text-brand-foreground md:hidden"
		>
			<Icon name="ph:list" class="block text-2xl" data-icon="open" />
			<Icon name="ph:x" class="hidden text-2xl" data-icon="close" />
		</button>
	</div>
	<nav
		id="mobile-nav"
		class="hidden border-t border-white/10 md:hidden"
		aria-hidden="true"
	>
		<ul class="container mx-auto flex max-w-[95vw] list-none text-center flex-col gap-2 py-2">
			<li>
				<a
					href="#about"
					class="block rounded-md px-2 py-2 text-base text-brand-foreground-darker transition-colors hover:bg-white/5 hover:text-brand-foreground"
					>About</a
				>
			</li>
			<li>
				<a
					href="#work"
					class="block rounded-md px-2 py-2 text-base text-brand-foreground-darker transition-colors hover:bg-white/5 hover:text-brand-foreground"
					>Work</a
				>
			</li>
			<li>
				<a
					href="#contact"
					class="block rounded-md px-2 py-2 text-base text-brand-foreground-darker transition-colors hover:bg-white/5 hover:text-brand-foreground"
					>Contact</a
				>
			</li>
		</ul>
	</nav>
</header>

<script>
	const header = document.getElementById("site-header");
	const toggle = document.getElementById("nav-toggle");
	const panel = document.getElementById("mobile-nav");

	if (header && toggle && panel) {
		const openIcon = toggle.querySelector('[data-icon="open"]');
		const closeIcon = toggle.querySelector('[data-icon="close"]');
		const links = panel.querySelectorAll("a");

		const setOpen = (open: boolean) => {
			panel.classList.toggle("hidden", !open);
			toggle.setAttribute("aria-expanded", String(open));
			toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
			panel.setAttribute("aria-hidden", String(!open));
			openIcon?.classList.toggle("hidden", open);
			openIcon?.classList.toggle("block", !open);
			closeIcon?.classList.toggle("hidden", !open);
			closeIcon?.classList.toggle("block", open);
		};

		const isOpen = () => toggle.getAttribute("aria-expanded") === "true";

		toggle.addEventListener("click", (event) => {
			event.stopPropagation();
			setOpen(!isOpen());
		});

		links.forEach((link) => {
			link.addEventListener("click", () => setOpen(false));
		});

		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape" && isOpen())
				setOpen(false);
		});

		document.addEventListener("click", (event) => {
			if (!isOpen())
				return;

			const target = event.target as Node | null;

			if (target && !header.contains(target))
				setOpen(false);
		});
	}
</script>
